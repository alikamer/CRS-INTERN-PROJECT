{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=crs_smart_receipt_db;Username=YOUR_USERNAME;Password=YOUR_PASSWORD"
  },
  //JWT ayarları
  "JwtSettings":{
    "Secret": "YOUR_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARS_LONG", //8x32->256 çöküyor yoksa
    "Issuer": "CRS_Smart_Receipt_API",
    "Audience": "CRS_Smart_Receipt_App"
  },
  "FileUploadSettings": {
    "ReceiptImagesPath": "C:/CRS_Uploads/Receipts"
  }
}
